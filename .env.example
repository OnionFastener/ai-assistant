# Copy to .env and fill in. Evertything under ASST_ overrides its matching config.
ASST_MOCK=1

# Single-user admin password for the web console
ASST_ADMIN_PASSWORD=change-me

# --- Jira Cloud ---
ASST_JIRA_BASE_URL=
ASST_JIRA_EMAIL=
ASST_JIRA_API_TOKEN=
# GitHub-for-Jira "Development" custom field id, e.g. customfield_10031 (optional)
ASST_JIRA_DEVINFO_FIELD=

# --- GitHub (context lookup + PR pushes) ---
# Repos to search and push for. The assistant picks the repo for each ticket:
#   1) project_repo_map below / config, 2) where the ticket's linked commits/PRs live, 3) first repo.
# ASST_GITHUB_REPO got superseded by ASST_GITHUB_REPOS when set.
ASST_GITHUB_REPOS=owner/repo-a,owner/repo-b
ASST_GITHUB_TOKEN=
# Optional authoritative Jira-project -> repo mapping (space-separated pairs). Overrides link evidence.
#ASST_GITHUB_PROJECT_MAP=PROJ=owner/repo-a OTHER=owner/repo-b
# Per-ticket overrides live in config/repo_map.json (editable in the web console) and are only
# consulted when the ticket text itself contains no github.com URL.
# Only if not github.com or you prefer SSH:
#ASST_GITHUB_HOST=github.com
#ASST_GITHUB_SSH_URL=git@github.com:owner/repo.git

# --- opencode AI layer ---
# Model ids are passed to `opencode run -m <id>` (provider/model). Empty = opencode default.
ASST_OP_MODEL_TRIAGE=
ASST_OP_MODEL_ACTION=

# --- live smoke test ---
# python3 scripts/smoke_live.py            (read-only: clone + context search + Jira search)
# python3 scripts/smoke_live.py --write    (also pushes a branch + opens/closes a PR)

# Sandbox where temp clones/large works go
ASST_WORKSPACE=/tmp/assistant