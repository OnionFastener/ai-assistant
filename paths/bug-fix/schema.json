{
  "name": "Bug Fix",
  "enabled": true,
  "allowed_actions": [
    "comment",
    "transition",
    "assign",
    "push_branch",
    "create_pr"
  ],
  "required_backend": "github",
  "work": {
    "clone": true
  },
  "approval": {
    "require_pr_diff": true,
    "editable": [
      "comment",
      "assignee"
    ]
  },
  "default_actions": [
    {
      "kind": "comment",
      "params": {
        "body": ""
      }
    },
    {
      "kind": "transition",
      "params": {
        "to": "In Review"
      }
    }
  ]
}